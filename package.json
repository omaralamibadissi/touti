{
  "name": "touti-game",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "shared",
    "server",
    "mobile"
  ],
  "scripts": {
    "dev:server": "npm --workspace server run dev",
    "dev:mobile": "npm --workspace mobile run start",
    "build:shared": "npm --workspace shared run build",
    "build": "npm --workspaces --if-present run build",
    "typecheck": "npm --workspaces --if-present run typecheck"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
